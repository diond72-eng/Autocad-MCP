FROM ghcr.io/astral-sh/uv:0.13.9 AS uv
FROM python:3.12-slim
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /cad
COPY . .
RUN --mount=type=secret,id=build_ca_bundle \
    if [ -s /run/secrets/build_ca_bundle ]; then \
        SSL_CERT_FILE=/run/secrets/build_ca_bundle uv sync --system-certs --locked --extra professional --no-dev; \
    else uv sync --system-certs --locked --extra professional --no-dev; fi
ENV PATH="/cad/.venv/bin:$PATH" XDG_CACHE_HOME=/tmp
ENTRYPOINT ["professional-cad"]
